{
  "name": "cloudstream-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "desktop": "tauri dev",
    "desktop:build": "npm run worker:build && tauri build --bundles deb",
    "worker:build": "bash scripts/build-worker.sh",
    "test": "cargo test -p cloudstream-core",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@tauri-apps/api": "^2.10.1",
    "lucide-svelte": "^0.468.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
